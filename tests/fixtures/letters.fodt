   </table:table>

   <text:p text:style-name="Standard">I expect the company to earn its keep from here, and to do it with a fraction of the capital it used to tie up.</text:p>
   <text:p text:style-name="Standard">Cordially,</text:p>
   <text:p text:style-name="Standard">Edward T. Lindqvist</text:p>

  </office:text>
 </office:body>
</office:document>
